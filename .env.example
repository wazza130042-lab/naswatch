# NASWatch Environment Configuration
# Copy this file to .env and configure local secret values

# Database Settings
DATABASE_PATH=data/inventory.db
DATABASE_SECRET_KEY=change-this-in-production-secret-key-32chars

# Webhook Alerting
ALERT_WEBHOOK_URL=https://webhook.site/sample-webhook-uuid
ALERT_WEBHOOK_TOKEN=your-bearer-token-if-required

# Syslog Alerting
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=514

# Live Capture Interface
CAPTURE_INTERFACE=any
CAPTURE_BPF_FILTER=sctp or port 38412
