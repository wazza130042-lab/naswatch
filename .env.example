# NASWatch Commercial — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to version control.

# ========== REQUIRED IN PRODUCTION ==========

# JWT signing secret (generate with: openssl rand -hex 32)
NASWATCH_JWT_SECRET=CHANGE-THIS-TO-A-RANDOM-256-BIT-KEY

# Database
POSTGRES_PASSWORD=change-me-in-production

# Redis
REDIS_PASSWORD=change-me-in-production

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# Default admin user (created on first boot)
NASWATCH_ADMIN_EMAIL=admin@yourorg.com
NASWATCH_ADMIN_PASSWORD=change-me-in-production

# ========== LICENSE ==========
# Obtain from https://naswatch.io/licensing
NASWATCH_LICENSE_KEY=

# ========== OPTIONAL INTEGRATIONS ==========

# PagerDuty (Events API v2 integration key)
PAGERDUTY_INTEGRATION_KEY=

# Splunk HEC
SPLUNK_HEC_URL=https://your-splunk-instance:8088/services/collector
SPLUNK_HEC_TOKEN=
SPLUNK_INDEX=naswatch_alerts

# Microsoft Sentinel
SENTINEL_WORKSPACE_ID=
SENTINEL_SHARED_KEY=
SENTINEL_LOG_TYPE=NASWatchAlerts

# JWT token expiry
NASWATCH_ACCESS_TOKEN_EXPIRE_MINUTES=60
NASWATCH_REFRESH_TOKEN_EXPIRE_DAYS=30

# Signaling flood detection thresholds
NASWATCH_FLOOD_THRESHOLD=10
NASWATCH_FLOOD_WINDOW_SECONDS=60

# API rate limiting
NASWATCH_RATE_LIMIT_PER_MINUTE=120
