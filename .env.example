# NASWatch Commercial — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to version control.

# ========== REQUIRED IN PRODUCTION ==========

# Generate with: openssl rand -hex 32
NASWATCH_JWT_SECRET=replace-with-at-least-64-random-hex-characters

# First administrator (optional). Set BOTH of these to seed the account
# unattended on first boot (containers, CI, infrastructure-as-code). Leave them
# unset and a fresh install instead shows the UI first-run setup screen, or you
# run scripts/create_admin.py. There is no built-in default password.
# Optional unattended first-admin creation. Leave both unset for UI first-run.
# NASWATCH_ADMIN_EMAIL=admin@yourorg.com
# NASWATCH_ADMIN_PASSWORD=use-a-unique-strong-password

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# PostgreSQL backend. Leave unset (or uncomment) to use the SQLite default.
# Used automatically when the URL starts with postgres:// or postgresql://.
# Leave unset for SQLite in local Compose. Production Compose defaults to the
# internal service hostname `db`; do not use 127.0.0.1 from inside a container.
# NASWATCH_DB_URL=postgresql://naswatch:<url-encoded-password>@db:5432/naswatch
# NASWATCH_DB_PATH=data/inventory.db

# PostgreSQL password (used by docker-compose.prod.yml for the db service)
POSTGRES_PASSWORD=replace-with-a-unique-url-safe-password

# ========== LICENSE ==========
# Obtain from https://naswatch.io/licensing
NASWATCH_LICENSE_KEY=

# ========== OPTIONAL INTEGRATIONS ==========

# Subscriber response integration. NASWatch inventory revocation works without
# this setting, but it does NOT block a subscriber on the 5G core. To enable an
# operator-managed core action, configure an HTTPS adapter that accepts
# POST {"imsi":"...","reason":"...","source":"NASWatch"}, authenticates
# Bearer tokens, and returns {"success":true} only after verifying the core change.
# Each analyst must still confirm the action in the incident page/API request.
# NASWATCH_CORE_REVOCATION_URL=
# NASWATCH_CORE_REVOCATION_TOKEN=

# OIDC / SSO (Enterprise). Issuer is the OpenID discovery base URL, e.g.
#   Keycloak:  https://idp.example.com/realms/naswatch
#   Entra ID:  https://login.microsoftonline.com/<tenant-id>/v2.0
#   Auth0:     https://<tenant>.auth0.com
# Set NASWATCH_OIDC_ENFORCED=true to disable password login org-wide (SSO-only).
NASWATCH_OIDC_ISSUER=
NASWATCH_OIDC_CLIENT_ID=naswatch-api
NASWATCH_OIDC_ADMIN_ROLES=naswatch-admins,superadmin
NASWATCH_OIDC_ANALYST_ROLES=naswatch-analysts
NASWATCH_OIDC_AUDITOR_ROLES=naswatch-auditors
NASWATCH_OIDC_ROLE_CLAIM=realm_access
NASWATCH_OIDC_TENANT_CLAIM=org_id
NASWATCH_OIDC_DEFAULT_ROLE=viewer
NASWATCH_OIDC_ENFORCED=false
# Production OIDC logins require an MFA indicator in the signed ID token's `amr`
# claim (for example `pwd`, `otp`). Disable only if MFA is enforced by the IdP.
NASWATCH_OIDC_MFA_REQUIRED=true

# Backup / DR (see scripts/backup.py)
# NASWATCH_BACKUP_DIR=backups
# Recommended cron:  0 2 * * * python3 /opt/naswatch/scripts/backup.py --compress gzip

# ========== OPTIONAL INTEGRATIONS ==========

# PagerDuty (Events API v2 integration key)
PAGERDUTY_INTEGRATION_KEY=

# Splunk HEC
SPLUNK_HEC_URL=https://your-splunk-instance:8088/services/collector
SPLUNK_HEC_TOKEN=
SPLUNK_INDEX=naswatch_alerts

# Microsoft Sentinel
SENTINEL_WORKSPACE_ID=
SENTINEL_SHARED_KEY=
SENTINEL_LOG_TYPE=NASWatchAlerts

# JWT token expiry
NASWATCH_ACCESS_TOKEN_EXPIRE_MINUTES=60
NASWATCH_REFRESH_TOKEN_EXPIRE_DAYS=30

# Signaling flood detection thresholds
NASWATCH_FLOOD_THRESHOLD=10
NASWATCH_FLOOD_WINDOW_SECONDS=60

# API rate limiting
NASWATCH_RATE_LIMIT_PER_MINUTE=120

# CORS (comma-separated allowlist; do not use * with credentials)
NASWATCH_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ========== COMPOSE / TLS (docker-compose.prod.yml) ==========

# Public FQDN the deployment is reachable at (sets TLS certs + CORS/UI API URL).
# Defaults to localhost with a self-signed internal Caddy cert.
NASWATCH_FQDN=naswatch.example.com
# Caddy TLS directive: use "tls internal" for a localhost/self-signed trial;
# leave empty for automatic public certificates on a real DNS name.
NASWATCH_TLS_MODE=
# API worker processes (week; scale with PostgreSQL, never with SQLite)
NASWATCH_WORKERS=1
# Override for tests that exercise the live PostgreSQL integration
# NASWATCH_TEST_PG_URL=postgresql://naswatch:change-me@127.0.0.1:5432/naswatch
